{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pulse-ivonix.site/contracts/pulse_error_v1.json",
  "title":"PULSE API Error Envelope v1",
  "type":"object","additionalProperties":false,
  "required":["error"],
  "properties":{"error":{"type":"object","additionalProperties":false,"required":["code","message","messageKey","requestId"],"properties":{"code":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z][a-z0-9_.-]*$"},"message":{"type":"string","minLength":1,"maxLength":2048},"messageKey":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[a-z][a-z0-9_.-]*$"},"details":{"type":"object"},"requestId":{"type":"string","minLength":1,"maxLength":128},"docsUrl":{"type":"string","format":"uri","maxLength":2048}}}}
}
