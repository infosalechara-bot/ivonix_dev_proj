{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PULSE Internal Service Identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["serviceId", "credentialVersion", "issuedAt", "expiresAt", "scopes"],
  "properties": {
    "serviceId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "credentialVersion": {"type": "integer", "const": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "organizationScope": {"type": "string", "format": "uuid"},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,127}$"}},
    "keyId": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
