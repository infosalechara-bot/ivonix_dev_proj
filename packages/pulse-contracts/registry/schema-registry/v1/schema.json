{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://contracts.pulse-ivonix.site/registry/schema-registry/v1","title":"PULSE Registry Entry v1","type":"object","additionalProperties":false,"required":["name","event_version","envelope_version","payload_schema","schema_status","compatibility"],"properties":{"name":{"type":"string","pattern":"^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"},"event_version":{"type":"integer","minimum":1},"envelope_version":{"const":1},"payload_schema":{"type":"object"},"schema_status":{"enum":["active","deprecated","retired"]},"compatibility":{"enum":["backward","forward","full","none"]},"deprecated_at":{"type":["string","null"]},"compatibility_until":{"type":["string","null"]},"successor":{"type":["string","null"]}}}